# ============================================================
# Konfiguracja systemu WMS Kontrola (ERP/WMS dla Fakturowni)
# Skopiuj ten plik jako `.env` i uzupełnij wartości.
# NIGDY nie commituj pliku .env do repozytorium.
# ============================================================

# --- Aplikacja ---
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
# Dozwolone originy CORS (frontend); w docker-compose frontend proxyfikuje /api,
# więc CORS jest potrzebny tylko przy developmencie na innym porcie.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Baza danych PostgreSQL ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=erp_wms
DATABASE_URL=postgresql+psycopg2://erp:change-me-strong-password@db:5432/erp_wms

# --- Bezpieczeństwo (sekrety generuj np. `openssl rand -hex 32`) ---
SECRET_KEY=change-me-random-64-hex
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Konto administratora (tworzone przy pierwszym starcie, gdy brak użytkowników) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=Administrator

# --- Fakturownia (INTEGRACJA WYŁĄCZNIE DO ODCZYTU) ---
# Subdomena konta: https://{FAKTUROWNIA_DOMAIN}.fakturownia.pl
FAKTUROWNIA_DOMAIN=mojafirma
# Token API (Ustawienia -> Ustawienia konta -> Integracje -> Kod autoryzacyjny API).
# Token NIE jest zapisywany w repozytorium, bazie ani logach (maskowanie sekretów).
FAKTUROWNIA_API_TOKEN=
# Limity komunikacji z API Fakturowni
FAKTUROWNIA_PER_PAGE=100
FAKTUROWNIA_RATE_LIMIT_RPS=2.0
FAKTUROWNIA_MAX_RETRIES=5
FAKTUROWNIA_TIMEOUT_SECONDS=30

# --- Harmonogram synchronizacji przyrostowej (APScheduler) ---
SYNC_SCHEDULE_ENABLED=false
SYNC_INTERVAL_MINUTES=60
